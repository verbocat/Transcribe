# Copy to .env.live (git-ignored) and fill in. Real environment variables take precedence.
LIVE_API_URL=https://your-backend.example.com
LIVE_UI_URL=https://noun.verbolabs.com/
# Dedicated NON-admin @verbolabs.com test account (the run aborts if it is an admin)
LIVE_TEST_EMAIL=
LIVE_TEST_PASSWORD=
# Seconds between requests (server limit is 300/min per IP; 1.0 keeps us at <= 60/min)
LIVE_MIN_INTERVAL=1.0
LIVE_TIMEOUT=30
# Optional: dedicated admin TEST account for ui/test_ui_40_admin.py (must be in the server's ADMIN_EMAILS;
# a personal super-admin account is refused)
LIVE_ADMIN_EMAIL=
LIVE_ADMIN_PASSWORD=
