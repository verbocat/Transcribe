# Gemini API Key (Required for transcription and transliteration)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection: gemini-3.8-flash (recommended for speed & quality) or gemini-3.8-

GEMINI_MODEL=gemini-3.8-flash
# ElevenLabs Scribe v2 Transcription Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_MODEL_ID=scribe_v2

# Default Target Language & Script (Can also be chosen per file)
DEFAULT_LANGUAGE=Hindi
DEFAULT_SCRIPT=Devanagari

# Karya Segmentation Limits (Defaults strictly conform to guidelines)
MAX_SEGMENT_DURATION=20.0
MIN_SEGMENT_DURATION=0.5
SEGMENT_BUFFER_SEC=0.3
MAX_SILENCE_SEC=4.0

# VerboLabs Authentication & Local Server Database (C: Drive)
# Target server path: C:\Users\Administrator.VERBOLABS.000\data\transcribe_app.db
SERVER_DB_PATH=C:\Users\Administrator.VERBOLABS.000\data\transcribe_app.db
FRONTEND_URL=http://localhost:5173

# Brevo Transactional Email Configuration
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@verbolabs.com
BREVO_SENDER_NAME=VerboLabs Verification
OTP_SECRET=your_otp_mfa_secret_key_2026

# Centroid API (subtitle translation + QC). URL is the Centroid server root, e.g. https://your-centroid-host
CENTROID_API_URL=
CENTROID_API_KEY=
